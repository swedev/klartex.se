# Base image for the klartex.se backend — the heavy, rarely changing
# layers. Published as ghcr.io/swedev/klartex-se-base by
# .github/workflows/backend-base.yml; backend/Dockerfile pins a tag +
# manifest digest from that registry and adds only the venv and the app
# source on top.
#
# This is layer substrate only: no WORKDIR, ENV, EXPOSE, HEALTHCHECK or
# CMD. Runtime configuration lives in backend/Dockerfile.

# Full TeX Live image — has everything klartex might need (tcolorbox,
# tikzfill, siunitx, fontspec, …) pre-installed. ~7 GB image, but build
# time is ~5 min instead of ~50+ min (no tlmgr install step). On the
# cax11 server (40 GB disk) the size is irrelevant; iteration speed wins.
FROM texlive/texlive:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv curl \
    && rm -rf /var/lib/apt/lists/*

# Microsoft core fonts (Georgia, Arial, Times New Roman, …) — common in
# user-supplied page templates. EULA accepted via debconf so install is
# non-interactive. fc-cache registers them so fontspec finds them at
# render time. Bundle authors can still ship their own .ttf as an asset.
RUN . /etc/os-release \
    && echo "deb http://deb.debian.org/debian $VERSION_CODENAME contrib" \
        > /etc/apt/sources.list.d/contrib.list \
    && apt-get update \
    && echo ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true \
        | debconf-set-selections \
    && apt-get install -y --no-install-recommends \
        ttf-mscorefonts-installer fontconfig \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

# texlive/texlive sets PATH via /etc/profile (login shell). uvicorn runs
# non-interactive, so symlink the arch-specific bin dir to a stable path.
# ENV PATH is set in the app Dockerfile, which also needs /opt/venv/bin.
RUN ln -s "$(ls -d /usr/local/texlive/*/bin/* | head -1)" /usr/local/texlive-bin

# Sanity check — runs per platform at build time and fails the build if
# the base is broken (dead symlink, missing TeX installation, failed font
# install). Absolute paths: the TeX binaries are not on PATH here.
RUN /usr/local/texlive-bin/xelatex --version \
    && /usr/local/texlive-bin/kpsewhich fontspec.sty \
    && fc-list | grep -qi georgia \
    && fc-list | grep -qi arial
