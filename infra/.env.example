# Copy to infra/.env on the server (or set in deploy/deploy.sh).
# Pin specific versions — never deploy :latest.

# The app service: policy, discovery, the page-template registry, /api.
# Released by a v* tag from this repo.
BACKEND_VERSION=0.9.1

# The render service: ghcr.io/swedev/klartex-render, built and published by
# swedev/klartex at every core release. Not a version series of its own —
# this is the `klartex==` pin from backend/pyproject.toml, and ci.yml fails
# when the two disagree. Every backend deploy writes both lines to the
# server's .env, so a core bump is a PR plus a tag.
KLARTEX_VERSION=0.19.0

# Postgres. Required — the stack does not start without it, and changing it
# on an existing volume locks the database out (the password is set once, at
# first initialisation). Back it up together with the dumps.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-me-with-32-byte-random-hex

# Optional bearer token. Set, it unlocks POST/DELETE on /api/page-templates
# and the `latex` block on POST /api/render for whoever presents it. Unset,
# those answer 503 and 403 for everyone; every other block renders anonymously.
# Generate with: openssl rand -hex 32
# API_TOKEN=replace-me-with-32-byte-random-hex

# The HMAC key over the six-digit sign-in codes. Required — the backend
# refuses to start without it. Six digits is a space that walks in
# microseconds against a plain digest, so the stored value is keyed with
# this, and this never reaches the database.
#
# It is a durable secret: replacing it invalidates every code that is
# already in someone's inbox. There is deliberately no per-process
# fallback — one would break every outstanding code at a restart, and
# every code minted by one worker for the next.
# Generate with: openssl rand -base64 32
LOGIN_CODE_SECRET=replace-me-with-32-byte-random-base64

# The public origin. Decides the session cookie's Secure flag and which
# Origin header counts as same-origin on the auth endpoints.
BASE_URL=https://app.klartex.se

# Comma-separated addresses treated as administrators. This is the only
# account state that is server configuration rather than a database row, so
# no sign-up can promote itself. Everyone else gets an ordinary account.
ADMIN_EMAILS=kontakt@klartex.se

# SMTP for the sign-in codes. Without a reachable server nobody can sign
# in — the code is the only way in.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=kontakt@klartex.se
