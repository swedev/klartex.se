# Copy to infra/.env on the server (or set in deploy/deploy.sh).
# Pin a specific backend version — never deploy :latest.
BACKEND_VERSION=0.4.2

# Bearer token required for POST/DELETE on /api/page-templates and for the
# `latex` block on POST /api/render. Every other block renders anonymously.
# Generate with: openssl rand -hex 32
API_TOKEN=replace-me-with-32-byte-random-hex
