# Copy to infra/.env on the server (or set in deploy/deploy.sh).
# Pin specific versions — never deploy :latest.

# The app service: policy, discovery, the page-template registry, /api.
# Released by a v* tag from this repo.
BACKEND_VERSION=0.7.0

# The render service: ghcr.io/swedev/klartex-render, built and published by
# swedev/klartex at every core release. Not a version series of its own —
# this is the `klartex==` pin from backend/pyproject.toml, and ci.yml fails
# when the two disagree. Every backend deploy writes both lines to the
# server's .env, so a core bump is a PR plus a tag.
KLARTEX_VERSION=0.17.0

# Postgres. Required — the stack does not start without it, and changing it
# on an existing volume locks the database out (the password is set once, at
# first initialisation). Back it up together with the dumps.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-me-with-32-byte-random-hex

# Optional bearer token. Set, it unlocks POST/DELETE on /api/page-templates
# and the `latex` block on POST /api/render for whoever presents it. Unset,
# those answer 503 and 403 for everyone; every other block renders anonymously.
# Generate with: openssl rand -hex 32
# API_TOKEN=replace-me-with-32-byte-random-hex
