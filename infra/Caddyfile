# klartex.se production Caddy config.
# Two vhosts share automatic Let's Encrypt TLS.

{
    email kontakt@klartex.se
    # Uncomment during initial DNS testing:
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# 1. Landing page — static index.html committed in this repo.
klartex.se, www.klartex.se {
    root * /srv/site
    file_server
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "strict-origin-when-cross-origin"
    }
    # www → apex
    @www host www.klartex.se
    redir @www https://klartex.se{uri} permanent
}

# 2. Webapp and API — one origin. Vite-built static bundle, with the whole
#    /api namespace proxied to the backend container.
app.klartex.se {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Content-Security-Policy   "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }

    # Bare /api is matched alongside /api/*, so nothing in the namespace
    # falls through to the SPA.
    @api path /api /api/*

    @render {
        method POST
        path /api/render
    }

    # Cap the render body before FastAPI parses it: the backend reads and
    # validates the whole JSON body before its concurrency semaphore is
    # reached. Caddy cuts the body off at the limit and answers 413.
    # /api/page-templates uploads carry fonts and are deliberately excluded.
    request_body @render {
        max_size 2MB
    }

    # Coarse per-IP cap on renders. Caddy has no trusted_proxies here, so
    # {client_ip} is the real peer address and X-Forwarded-For cannot
    # bypass it. IPv6 is bucketed per /64 so address rotation inside one
    # prefix shares a bucket. Other endpoints stay unlimited.
    rate_limit {
        zone render_per_ip {
            match {
                method POST
                path /api/render
            }
            key         {client_ip}
            events      10
            window      1m
            ipv6_prefix 64
        }
    }

    handle @api {
        reverse_proxy backend:8000 {
            # PDF responses can be a few MB; keep timeouts generous. A render
            # is two xelatex runs of up to 60s each, so the proxy must wait
            # longer than the worst legitimate case.
            transport http {
                response_header_timeout 150s
            }
        }
    }

    handle {
        root * /srv/app
        try_files {path} /index.html   # SPA fallback
        file_server
    }
}
